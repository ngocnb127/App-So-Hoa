# Sao chép file này thành keystore.properties và điền giá trị thật.
# keystore.properties nằm trong .gitignore — KHÔNG BAO GIỜ commit nó.
#
# Cách khác: đặt các biến môi trường sau (ưu tiên thấp hơn keystore.properties):
#   FMS_KEYSTORE_PATH
#   FMS_KEYSTORE_PASSWORD
#   FMS_KEY_ALIAS
#   FMS_KEY_PASSWORD
#
# Nếu không có nguồn nào, bản release sẽ không được ký (build vẫn chạy).

storeFile=keys/fms4.jks
storePassword=CHANGE_ME
keyAlias=CHANGE_ME
keyPassword=CHANGE_ME
