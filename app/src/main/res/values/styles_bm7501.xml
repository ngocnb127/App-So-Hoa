<?xml version="1.0" encoding="utf-8"?>
<!--
  Style dùng chung cho màn BM 75.01 để mọi dòng nhập có cùng cỡ chữ, cùng lề.
  Bản trước mỗi dòng tự khai thuộc tính nên giao diện lệch nhau.
-->
<resources>

    <!-- Gốc của nhánh style BM7501: để dạng "BM7501.X" kế thừa được. -->
    <style name="BM7501" />

    <style name="BM7501.Section">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@color/colorPrimary</item>
        <item name="android:padding">8dp</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:textColor">#fff</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Lời dẫn in sẵn trên biểu mẫu giấy: đọc để biết đang khai mục nào. -->
    <style name="BM7501.Note">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">italic</item>
    </style>

    <style name="BM7501.Row">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
    </style>

    <style name="BM7501.Label">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">0.38</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="BM7501.Input">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">0.62</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:inputType">text</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="BM7501.Input.Number">
        <item name="android:inputType">numberDecimal|numberSigned</item>
    </style>

    <!-- Ô giờ: không gõ tay, chạm để chọn ngày giờ. -->
    <style name="BM7501.Input.Time">
        <item name="android:focusable">false</item>
        <item name="android:clickable">true</item>
        <item name="android:inputType">none</item>
        <item name="android:onClick">onClick</item>
    </style>

    <style name="BM7501.Choice">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingTop">1dp</item>
        <item name="android:paddingBottom">1dp</item>
    </style>

    <style name="BM7501.Choice.Inline">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_marginEnd">24dp</item>
        <item name="android:layout_marginRight">24dp</item>
    </style>

    <style name="BM7501.Group">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingLeft">8dp</item>
    </style>

    <!-- Nhóm hai lựa chọn ngắn (Có/Không, Đạt/Không đạt) nằm cùng một dòng. -->
    <style name="BM7501.Group.Inline">
        <item name="android:orientation">horizontal</item>
    </style>

</resources>
