<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="AppTheme.NoActionBar.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.NoActionBar.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="AppTheme.NoActionBar.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <!-- ==================== Popup trạng thái Router RUT ====================
         Popup dùng theme MaterialComponents RIÊNG chứ không đổi theme toàn app: các
         MaterialButton/MaterialCardView bên trong đòi theme Material, còn app đang chạy
         Theme.AppCompat và đổi theme gốc là chạm vào mọi màn hình đã ổn định. -->
    <style name="RutBottomSheetTheme" parent="Theme.MaterialComponents.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/RutBottomSheetStyle</item>
        <item name="colorPrimary">@color/rutAccent</item>
        <item name="colorAccent">@color/rutAccent</item>
    </style>

    <style name="RutBottomSheetStyle" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="shapeAppearanceOverlay">@style/RutBottomSheetShape</item>
        <item name="backgroundTint">@color/colorWhite</item>
    </style>

    <style name="RutBottomSheetShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="RutCard" parent="Widget.MaterialComponents.CardView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/rutCardStroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/colorWhite</item>
    </style>

    <style name="RutRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="RutRowIcon">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <!-- Nhãn co giãn được: ở cỡ chữ 2.0 nhãn dài phải xuống dòng thay vì đẩy giá trị ra
         khỏi màn hình. -->
    <style name="RutRowLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:textColor">@color/rutTextPrimary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="RutRowValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:gravity">end</item>
        <item name="android:textColor">@color/rutTextPrimary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="RutDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:background">@color/rutCardStroke</item>
    </style>

    <style name="RutSignalBar">
        <item name="android:layout_width">7dp</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:background">@color/rutBarEmpty</item>
    </style>

    <style name="RutMetric">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/rutTextSecondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="RutMetricDivider">
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@color/rutCardStroke</item>
    </style>

    <style name="RutCheckLine">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:minHeight">28dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:textColor">@color/rutTextPrimary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Tiêu đề thẻ ở bản rút gọn: chiếm phần còn lại của hàng và tự xuống dòng ở cỡ chữ
         lớn thay vì bị cắt cụt. -->
    <style name="RutSectionTitle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:textColor">@color/rutTextPrimary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Dòng giá trị duy nhất của mỗi thẻ. Chiếm trọn bề ngang và KHÔNG giới hạn số dòng:
         ở cỡ chữ 2.0 trên màn 320dp nó phải được phép xuống dòng, không được bóp lại. -->
    <style name="RutSummaryValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/rutTextPrimary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
