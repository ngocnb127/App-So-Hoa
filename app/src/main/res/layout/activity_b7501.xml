<?xml version="1.0" encoding="utf-8"?>
<!--
  BM 75.01/NLHK — phiếu yêu cầu hút nhiên liệu từ tàu bay.

  Bố cục bám đúng biểu mẫu giấy: mục A (khách hàng khai) - mục B (SKYPEC) - mục C (hai bên
  xác nhận), cùng thứ tự, cùng lời dẫn. KHÔNG thêm ô nào ngoài biểu mẫu.

  Các thông tin đã có từ mẻ hút (số phiếu, ngày giờ, hãng, sân bay) hiện ở đầu phiếu dạng
  chỉ đọc — nhân viên không phải gõ lại.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/colorPrimary">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <Button android:id="@+id/btnBack" android:layout_width="wrap_content"
                android:layout_height="match_parent" android:drawableStart="@drawable/ic_exit"
                android:onClick="onClick" android:text="@string/back" />

            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center"
                android:text="@string/bm7501_title" android:textColor="#fff"
                android:textSize="18sp" android:textStyle="bold" />

            <Button android:id="@+id/btnSave7501" android:layout_width="wrap_content"
                android:layout_height="match_parent" android:onClick="onClick"
                android:text="@string/save" />

            <Button android:id="@+id/btnExport7501" android:layout_width="wrap_content"
                android:layout_height="match_parent" android:onClick="onClick"
                android:text="@string/bm7501_export" />

            <Button android:id="@+id/btnPrint7501" android:layout_width="wrap_content"
                android:layout_height="match_parent" android:onClick="onClick"
                android:text="@string/print_bm7501" android:visibility="gone" />
        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/bm7501_form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView android:id="@+id/bm7501_status" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:paddingBottom="2dp"
                android:textSize="16sp" android:textStyle="bold" />

            <!-- Kế thừa từ mẻ hút: ngày giờ, hãng hàng không, sân bay. -->
            <TextView android:id="@+id/bm7501_context" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:paddingBottom="4dp"
                android:textSize="15sp" />

            <!-- ==================================================== MỤC A -->
            <TextView style="@style/BM7501.Section"
                android:text="@string/bm7501_section_a" />

            <TextView style="@style/BM7501.Note" android:text="@string/bm7501_note_section_a" />

            <LinearLayout style="@style/BM7501.Row">
                <TextView style="@style/BM7501.Label" android:text="@string/bm7501_customer_rep" />
                <EditText android:id="@+id/f_customerRepName" style="@style/BM7501.Input"
                    android:inputType="textPersonName|textCapWords" />
            </LinearLayout>

            <LinearLayout style="@style/BM7501.Row">
                <TextView style="@style/BM7501.Label" android:text="@string/bm7501_title_position" />
                <EditText android:id="@+id/f_customerTitle" style="@style/BM7501.Input" />
            </LinearLayout>

            <LinearLayout style="@style/BM7501.Row">
                <TextView style="@style/BM7501.Label" android:text="@string/bm7501_tel" />
                <EditText android:id="@+id/f_customerTel" style="@style/BM7501.Input"
                    android:layout_weight="0.24" android:inputType="phone" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:paddingStart="8dp" android:paddingLeft="8dp" android:paddingEnd="6dp"
                    android:paddingRight="6dp" android:text="@string/bm7501_fax" android:textSize="16sp" />
                <EditText android:id="@+id/f_customerFax" style="@style/BM7501.Input"
                    android:layout_weight="0.24" android:inputType="phone" />
            </LinearLayout>

            <LinearLayout style="@style/BM7501.Row">
                <TextView style="@style/BM7501.Label" android:text="@string/bm7501_aircraft" />
                <EditText android:id="@+id/f_aircraftType" style="@style/BM7501.Input"
                    android:layout_weight="0.29" android:inputType="textCapCharacters" />
                <EditText android:id="@+id/f_aircraftReg" style="@style/BM7501.Input"
                    android:layout_weight="0.33" android:inputType="textCapCharacters" />
            </LinearLayout>

            <TextView style="@style/BM7501.Note" android:text="@string/bm7501_reason" />

            <RadioGroup android:id="@+id/f_reason" style="@style/BM7501.Group">
                <RadioButton android:id="@+id/f_reason_load" style="@style/BM7501.Choice"
                    android:text="@string/bm7501_reason_load" />
                <RadioButton android:id="@+id/f_reason_maint" style="@style/BM7501.Choice"
                    android:text="@string/bm7501_reason_maint" />
                <RadioButton android:id="@+id/f_reason_other" style="@style/BM7501.Choice"
                    android:text="@string/bm7501_reason_other" />
            </RadioGroup>

            <LinearLayout android:id="@+id/row_reasonOther" style="@style/BM7501.Row"
                android:visibility="gone">
                <TextView style="@style/BM7501.Label" android:text="@string/bm7501_specify" />
                <EditText android:id="@+id/f_reasonOther" style="@style/BM7501.Input" />
            </LinearLayout>

            <TextView style="@style/BM7501.Note" android:text="@string/bm7501_a1_tank_drain" />

            <RadioGroup android:id="@+id/f_tankDrain" style="@style/BM7501.Group.Inline">
                <RadioButton android:id="@+id/f_tankDrain_yes" style="@style/BM7501.Choice.Inline"
                    android:text="@string/bm7501_yes" />
                <RadioButton android:id="@+id/f_tankDrain_no" style="@style/BM7501.Choice.Inline"
                    android:text="@string/bm7501_no" />
            </RadioGroup>

            <TextView style="@style/BM7501.Note" android:text="@string/bm7501_a2_microbial" />

            <TextView style="@style/BM7501.Note" android:text="@string/bm7501_test_kit" />

            <RadioGroup android:id="@+id/f_custMicroKit" style="@style/BM7501.Group">
                <RadioButton android:id="@+id/f_custKit_hylite" style="@style/BM7501.Choice"
                    android:text="@string/bm7501_kit_hylite" />
                <RadioButton android:id="@+id/f_custKit_mm2" style="@style/BM7501.Choice"
                    android:text="@string/bm7501_kit_mm2" />
                <RadioButton android:id="@+id/f_custKit_fuelstat" style="@style/BM7501.Choice"
                    android:text="@string/bm7501_kit_fuelstat" />
                <RadioButton android:id="@+id/f_custKit_other" style="@style/BM7501.Choice"
                    android:text="@string/bm7501_kit_other" />
            </RadioGroup>

            <LinearLayout android:id="@+id/row_custKitOther" style="@style/BM7501.Row"
                android:visibility="gone">
                <TextView style="@style/BM7501.Label" android:text="@string/bm7501_specify" />
                <EditText android:id="@+id/f_custMicroKitOther" style="@style/BM7501.Input" />
            </LinearLayout>

            <TextView style="@style/BM7501.Note" android:text="@string/bm7501_test_result" />

            <RadioGroup android:id="@+id/f_custMicroResult" style="@style/BM7501.Group">
                <RadioButton android:id="@+id/f_custRes_normal" style="@style/BM7501.Choice"
                    android:text="@string/bm7501_level_normal" />
                <RadioButton android:id="@+id/f_custRes_warning" style="@style/BM7501.Choice"
                    android:text="@string/bm7501_level_warning" />
                <RadioButton android:id="@+id/f_custRes_action" style="@style/BM7501.Choice"
                    android:text="@string/bm7501_level_action" />
            </RadioGroup>

            <TextView style="@style/BM7501.Note" android:text="@string/bm7501_a3_additives" />

            <LinearLayout style="@style/BM7501.Group">
                <CheckBox android:id="@+id/f_add_fsii" style="@style/BM7501.Choice" android:text="FSII" />
                <CheckBox android:id="@+id/f_add_biocide" style="@style/BM7501.Choice" android:text="Biocide" />
                <CheckBox android:id="@+id/f_add_aquarius" style="@style/BM7501.Choice" android:text="Aquarius WMA" />
                <CheckBox android:id="@+id/f_add_none" style="@style/BM7501.Choice"
                    android:text="@string/bm7501_additive_none" />
                <CheckBox android:id="@+id/f_add_undet" style="@style/BM7501.Choice"
                    android:text="@string/bm7501_additive_undetermined" />
            </LinearLayout>

            <TextView style="@style/BM7501.Note" android:text="@string/bm7501_a4_prev_locations" />

            <LinearLayout style="@style/BM7501.Row">
                <TextView style="@style/BM7501.Label" android:text="@string/bm7501_location_1" />
                <EditText android:id="@+id/f_prevLocation1" style="@style/BM7501.Input"
                    android:layout_weight="0.29" android:inputType="textCapCharacters" />
                <EditText android:id="@+id/f_prevGrade1" style="@style/BM7501.Input"
                    android:layout_weight="0.33" android:hint="@string/bm7501_grade_hint" />
            </LinearLayout>

            <LinearLayout style="@style/BM7501.Row">
                <TextView style="@style/BM7501.Label" android:text="@string/bm7501_location_2" />
                <EditText android:id="@+id/f_prevLocation2" style="@style/BM7501.Input"
                    android:layout_weight="0.29" android:inputType="textCapCharacters" />
                <EditText android:id="@+id/f_prevGrade2" style="@style/BM7501.Input"
                    android:layout_weight="0.33" android:hint="@string/bm7501_grade_hint" />
            </LinearLayout>

            <Button android:id="@+id/btnPrevUndetermined" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_gravity="end"
                android:onClick="onClick" android:text="@string/bm7501_fill_undetermined"
                android:textSize="13sp" />

            <!-- ==================================================== MỤC B -->
            <TextView style="@style/BM7501.Section" android:text="@string/bm7501_section_b" />

            <TextView style="@style/BM7501.Note" android:text="@string/bm7501_b1_quality" />

            <LinearLayout style="@style/BM7501.Row">
                <TextView style="@style/BM7501.Label" android:text="@string/bm7501_vac" />
                <RadioGroup android:id="@+id/f_vac" style="@style/BM7501.Group.Inline"
                    android:layout_width="0dp" android:layout_weight="0.62">
                    <RadioButton android:id="@+id/f_vac_ok" style="@style/BM7501.Choice.Inline"
                        android:text="@string/bm7501_satisfy" />
                    <RadioButton android:id="@+id/f_vac_no" style="@style/BM7501.Choice.Inline"
                        android:text="@string/bm7501_not_satisfy" />
                </RadioGroup>
            </LinearLayout>

            <LinearLayout style="@style/BM7501.Row">
                <TextView style="@style/BM7501.Label" android:text="@string/bm7501_cwd" />
                <RadioGroup android:id="@+id/f_cwd" style="@style/BM7501.Group.Inline"
                    android:layout_width="0dp" android:layout_weight="0.62">
                    <RadioButton android:id="@+id/f_cwd_ok" style="@style/BM7501.Choice.Inline"
                        android:text="@string/bm7501_satisfy" />
                    <RadioButton android:id="@+id/f_cwd_no" style="@style/BM7501.Choice.Inline"
                        android:text="@string/bm7501_not_satisfy" />
                </RadioGroup>
            </LinearLayout>

            <LinearLayout style="@style/BM7501.Row">
                <TextView style="@style/BM7501.Label" android:text="@string/bm7501_density_check" />
                <EditText android:id="@+id/f_densityKgM3" style="@style/BM7501.Input.Number" />
            </LinearLayout>

            <LinearLayout style="@style/BM7501.Row">
                <TextView style="@style/BM7501.Label" android:text="@string/bm7501_conductivity" />
                <EditText android:id="@+id/f_conductivityPsM" style="@style/BM7501.Input.Number" />
            </LinearLayout>

            <TextView style="@style/BM7501.Note" android:text="@string/bm7501_b2_microbial" />

            <TextView style="@style/BM7501.Note" android:text="@string/bm7501_test_kit" />

            <RadioGroup android:id="@+id/f_skypecMicroKit" style="@style/BM7501.Group">
                <RadioButton android:id="@+id/f_skKit_hylite" style="@style/BM7501.Choice"
                    android:text="@string/bm7501_kit_hylite" />
                <RadioButton android:id="@+id/f_skKit_mm2" style="@style/BM7501.Choice"
                    android:text="@string/bm7501_kit_mm2" />
                <RadioButton android:id="@+id/f_skKit_fuelstat" style="@style/BM7501.Choice"
                    android:text="@string/bm7501_kit_fuelstat" />
            </RadioGroup>

            <TextView style="@style/BM7501.Note" android:text="@string/bm7501_test_result" />

            <RadioGroup android:id="@+id/f_skypecMicroResult" style="@style/BM7501.Group">
                <RadioButton android:id="@+id/f_skRes_normal" style="@style/BM7501.Choice"
                    android:text="@string/bm7501_level_normal" />
                <RadioButton android:id="@+id/f_skRes_warning" style="@style/BM7501.Choice"
                    android:text="@string/bm7501_level_warning" />
                <RadioButton android:id="@+id/f_skRes_action" style="@style/BM7501.Choice"
                    android:text="@string/bm7501_level_action" />
            </RadioGroup>

            <!-- ==================================================== MỤC C -->
            <TextView style="@style/BM7501.Section" android:text="@string/bm7501_section_c" />

            <LinearLayout style="@style/BM7501.Row">
                <TextView style="@style/BM7501.Label" android:text="@string/bm7501_defueller" />
                <EditText android:id="@+id/f_defuellerTruckNo" style="@style/BM7501.Input" />
            </LinearLayout>

            <LinearLayout style="@style/BM7501.Row">
                <TextView style="@style/BM7501.Label" android:text="@string/bm7501_start_time" />
                <EditText android:id="@+id/f_startTime" style="@style/BM7501.Input.Time" />
            </LinearLayout>

            <LinearLayout style="@style/BM7501.Row">
                <TextView style="@style/BM7501.Label" android:text="@string/bm7501_end_time" />
                <EditText android:id="@+id/f_endTime" style="@style/BM7501.Input.Time" />
            </LinearLayout>

            <TextView style="@style/BM7501.Note" android:text="@string/bm7501_method" />

            <RadioGroup android:id="@+id/f_method" style="@style/BM7501.Group">
                <RadioButton android:id="@+id/f_method_ac" style="@style/BM7501.Choice"
                    android:text="@string/bm7501_method_aircraft" />
                <RadioButton android:id="@+id/f_method_ref" style="@style/BM7501.Choice"
                    android:text="@string/bm7501_method_refueller" />
                <RadioButton android:id="@+id/f_method_both" style="@style/BM7501.Choice"
                    android:text="@string/bm7501_method_both" />
            </RadioGroup>

            <TextView style="@style/BM7501.Note" android:text="@string/bm7501_method_note" />

            <TextView style="@style/BM7501.Note" android:text="@string/bm7501_signals" />

            <LinearLayout style="@style/BM7501.Group">
                <CheckBox android:id="@+id/f_signalThumb" style="@style/BM7501.Choice"
                    android:text="@string/bm7501_signal_thumb" />
                <CheckBox android:id="@+id/f_signalCross" style="@style/BM7501.Choice"
                    android:text="@string/bm7501_signal_cross" />
            </LinearLayout>

            <LinearLayout style="@style/BM7501.Row">
                <TextView style="@style/BM7501.Label" android:text="@string/bm7501_signal_other" />
                <EditText android:id="@+id/f_otherSignal" style="@style/BM7501.Input" />
            </LinearLayout>

            <TextView style="@style/BM7501.Note" android:text="@string/bm7501_quantity" />

            <LinearLayout style="@style/BM7501.Row">
                <TextView style="@style/BM7501.Label" android:text="@string/bm7501_expected_kg" />
                <EditText android:id="@+id/f_expectedKg" style="@style/BM7501.Input.Number" />
            </LinearLayout>

            <LinearLayout style="@style/BM7501.Row">
                <TextView style="@style/BM7501.Label" android:text="@string/bm7501_actual_kg" />
                <EditText android:id="@+id/f_actualKg" style="@style/BM7501.Input.Number" />
            </LinearLayout>

            <LinearLayout style="@style/BM7501.Row">
                <TextView style="@style/BM7501.Label" android:text="@string/bm7501_actual_temp" />
                <EditText android:id="@+id/f_actualTempC" style="@style/BM7501.Input.Number" />
            </LinearLayout>

            <LinearLayout style="@style/BM7501.Row">
                <TextView style="@style/BM7501.Label" android:text="@string/bm7501_actual_density" />
                <EditText android:id="@+id/f_actualDensityKgM3" style="@style/BM7501.Input.Number" />
            </LinearLayout>

            <LinearLayout style="@style/BM7501.Row">
                <TextView style="@style/BM7501.Label" android:text="@string/bm7501_conversion" />
                <EditText android:id="@+id/f_gallon" style="@style/BM7501.Input.Number"
                    android:layout_weight="0.31" android:hint="@string/bm7501_gal" />
                <EditText android:id="@+id/f_liter" style="@style/BM7501.Input.Number"
                    android:layout_weight="0.31" android:hint="@string/bm7501_litter" />
            </LinearLayout>

            <TextView style="@style/BM7501.Note" android:text="@string/bm7501_c1_refuellable" />

            <RadioGroup android:id="@+id/f_refuellable" style="@style/BM7501.Group.Inline">
                <RadioButton android:id="@+id/f_refuellable_yes" style="@style/BM7501.Choice.Inline"
                    android:text="@string/bm7501_agree" />
                <RadioButton android:id="@+id/f_refuellable_no" style="@style/BM7501.Choice.Inline"
                    android:text="@string/bm7501_no" />
            </RadioGroup>

            <TextView style="@style/BM7501.Note" android:text="@string/bm7501_c2_handling" />

            <RadioGroup android:id="@+id/f_handling" style="@style/BM7501.Group">
                <RadioButton android:id="@+id/f_handling_storage" style="@style/BM7501.Choice"
                    android:text="@string/bm7501_handling_storage" />
                <RadioButton android:id="@+id/f_handling_same" style="@style/BM7501.Choice"
                    android:text="@string/bm7501_handling_same_aircraft" />
                <RadioButton android:id="@+id/f_handling_other_ac" style="@style/BM7501.Choice"
                    android:text="@string/bm7501_handling_other_aircraft" />
                <RadioButton android:id="@+id/f_handling_authorize" style="@style/BM7501.Choice"
                    android:text="@string/bm7501_handling_authorize" />
                <RadioButton android:id="@+id/f_handling_despite" style="@style/BM7501.Choice"
                    android:text="@string/bm7501_handling_despite_issue" />
            </RadioGroup>

            <LinearLayout android:id="@+id/row_storage" style="@style/BM7501.Row"
                android:visibility="gone">
                <TextView style="@style/BM7501.Label" android:text="@string/bm7501_storage_from_to" />
                <EditText android:id="@+id/f_storageFrom" style="@style/BM7501.Input.Time"
                    android:layout_weight="0.31" />
                <EditText android:id="@+id/f_storageTo" style="@style/BM7501.Input.Time"
                    android:layout_weight="0.31" />
            </LinearLayout>

            <LinearLayout android:id="@+id/row_handlingNote" style="@style/BM7501.Row"
                android:visibility="gone">
                <TextView style="@style/BM7501.Label" android:text="@string/bm7501_issue_note" />
                <EditText android:id="@+id/f_handlingNote" style="@style/BM7501.Input" />
            </LinearLayout>

            <!-- =============================================== chữ ký cuối phiếu -->
            <TextView style="@style/BM7501.Section" android:text="@string/bm7501_signatures" />

            <LinearLayout style="@style/BM7501.Row">
                <TextView style="@style/BM7501.Label" android:text="@string/bm7501_skypec_rep" />
                <EditText android:id="@+id/f_skypecRepName" style="@style/BM7501.Input"
                    android:inputType="textPersonName|textCapWords" />
            </LinearLayout>

            <LinearLayout style="@style/BM7501.Row">
                <TextView android:id="@+id/lbl_sign_seller" style="@style/BM7501.Label"
                    android:layout_weight="0.62" android:textSize="15sp" />
                <Button android:id="@+id/btnSignSeller" android:layout_width="0dp"
                    android:layout_weight="0.38" android:layout_height="wrap_content"
                    android:onClick="onClick" android:text="@string/bm7501_sign_skypec" />
            </LinearLayout>

            <ImageView android:id="@+id/img_sign_seller" android:layout_width="match_parent"
                android:layout_height="110dp" android:adjustViewBounds="true"
                android:background="@android:color/white" android:contentDescription="@string/bm7501_sign_label_skypec"
                android:scaleType="fitStart" android:visibility="gone" />

            <TextView style="@style/BM7501.Note" android:text="@string/bm7501_customer_rep_note" />

            <LinearLayout style="@style/BM7501.Row">
                <TextView android:id="@+id/lbl_sign_buyer" style="@style/BM7501.Label"
                    android:layout_weight="0.62" android:textSize="15sp" />
                <Button android:id="@+id/btnSignBuyer" android:layout_width="0dp"
                    android:layout_weight="0.38" android:layout_height="wrap_content"
                    android:onClick="onClick" android:text="@string/bm7501_sign_customer" />
            </LinearLayout>

            <ImageView android:id="@+id/img_sign_buyer" android:layout_width="match_parent"
                android:layout_height="110dp" android:adjustViewBounds="true"
                android:background="@android:color/white" android:contentDescription="@string/bm7501_sign_label_customer"
                android:scaleType="fitStart" android:visibility="gone" />

            <TextView style="@style/BM7501.Note" android:text="@string/bm7501_footer_note" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
